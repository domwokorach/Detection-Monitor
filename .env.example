# Copy to .env; set fresh strong secrets before any exposed deployment.
POSTGRES_USER=fraudapp
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=frauddb
JWT_SECRET=DEV_ONLY_replace_with_32_bytes_of_random_secret
DEMO_ADMIN_PASSWORD=ChangeMe123!
DEMO_ANALYST_PASSWORD=ChangeMe123!
ALERT_THRESHOLD=40

# TrueLayer UK banking *sandbox* (leave the secret blank in git; set it in your local .env only)
TRUELAYER_CLIENT_ID=sandbox-detectionmonitor-9d3c22
TRUELAYER_CLIENT_SECRET=
# For the in-app flow use http://localhost:5173/truelayer/callback (dev) or http://localhost:8080/truelayer/callback (compose),
# and register exactly that URI in TrueLayer Console. The console redirect page also works, but you must paste the code by hand.
TRUELAYER_REDIRECT_URI=http://localhost:5173/truelayer/callback
TRUELAYER_API_URL=https://api.truelayer-sandbox.com
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com

# Logo.dev merchant logos.
# LOGO_DEV_SECRET_KEY (sk_...) is read ONLY by the FastAPI backend for /api/brands/search. Never prefix it with VITE_.
LOGO_DEV_SECRET_KEY=
# VITE_LOGO_DEV_PUBLISHABLE_KEY (pk_...) is public by design; it is baked into the frontend bundle for img.logo.dev.
# Put it in frontend/.env.local for `npm run dev`; docker compose reads it from this file at build time.
VITE_LOGO_DEV_PUBLISHABLE_KEY=


